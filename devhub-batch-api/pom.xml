<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.devhub.batch</groupId>
    <artifactId>devhub-batch-api</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>DevHub Batch API</name>
    <description>Spring Boot 3 REST + WebSocket API for devhub-batch-core (read model + controlled writes)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- The scheduler engine: pure JDBC, no Spring runtime inside. -->
        <dependency>
            <groupId>com.devhub.batch</groupId>
            <artifactId>devhub-batch-core</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <!-- core ships slf4j-simple; the API uses Logback from Boot. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JdbcTemplate read model + Hikari DataSource shared with core. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Demo profile only: H2 in MySQL compatibility mode (same schema as core tests). -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>devhub-batch-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- devhub-batch-core ships its shaded CLI jar with slf4j-simple
                         bundled; force the Logback provider when running via Maven. -->
                    <jvmArguments>-Dslf4j.provider=ch.qos.logback.classic.spi.LogbackServiceProvider</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
